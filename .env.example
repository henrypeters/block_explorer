# Bitcoin Core RPC connection (Polar regtest defaults)
RPC_URL=http://127.0.0.1:18443
RPC_USER=polaruser
RPC_PASSWORD=polarpass

# PostgreSQL connection
# Local:  postgres://postgres:password@localhost:5432/block_explorer
# Docker: postgres://postgres:password@localhost:5432/block_explorer
DATABASE_URL=postgres://postgres:password@localhost:5432/block_explorer

# Bitcoin network: regtest | testnet | mainnet
BITCOIN_NETWORK=regtest

# ZMQ block notifications (from Polar's Bitcoin Core connect tab)
ZMQ_BLOCK_URL=tcp://127.0.0.1:28334

# Logging
RUST_LOG=info
